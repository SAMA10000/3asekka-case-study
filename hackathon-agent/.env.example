# Never commit real credentials. Copy this file to .env locally if needed.
PORT=3000

# Optional AI extraction provider.
# Provider priority: Gemini -> OpenAI -> generic OpenAI-compatible endpoint.
# If none is configured, the agent safely falls back to deterministic Arabic parsing.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Generic OpenAI-compatible endpoint (optional)
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=

# Set to 1 to force deterministic mode (used by CI/evaluation).
FORCE_RULES_ONLY=0

# Demo-only pricing. Production pricing remains private/server-side.
DEMO_MOTORBIKE_BASE=15
DEMO_MOTORBIKE_PER_KM=2
DEMO_TRICYCLE_BASE=20
DEMO_TRICYCLE_PER_KM=2.8
DEMO_VAN_BASE=45
DEMO_VAN_PER_KM=5.5
DEMO_QUARTER_PICKUP_BASE=30
DEMO_QUARTER_PICKUP_PER_KM=3.75
